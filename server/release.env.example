# Копируется в <каталог артефакта>/release.env на сервере. Строки KEY=VALUE, файл не исполняется.
# Владелец: тот, под кем работает артефакт (для артефакта под root: root:root 600).

# Куда приходят архивы и где лежат релизы. По умолчанию рядом с release.env.
#INCOMING=/srv/my-project/backend/incoming
#RELEASES=/srv/my-project/backend/releases
#CURRENT=/srv/my-project/backend/current

# Сколько релизов держать на диске. Не меньше 2: текущий и прежний нужны для отката.
KEEP_RELEASES=5

# Выполняется в каталоге нового релиза ДО переключения симлинка. Не прошла: прод не тронут.
# Сюда идут миграции базы. Переменная RELEASE_DIR указывает на каталог релиза.
PRE_SWITCH_CMD=

# Выполняется в каталоге current ПОСЛЕ переключения. Пример: docker compose up -d --build
# или pm2 reload my-project
RESTART_CMD=

# Адрес проверки здоровья на самом сервере. Ждём код 200 до HEALTH_WAIT секунд.
# Не ответил: симлинк возвращается на прежний релиз, RESTART_CMD вызывается снова.
HEALTH_URL=http://127.0.0.1:8000/health
HEALTH_WAIT=60
HEALTH_INTERVAL=2
