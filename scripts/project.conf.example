# Copy to scripts/project.conf and fill in. project.conf is not committed (see .gitignore).
# Plain KEY=VALUE lines: read by db-backup.sh (server) and by the PowerShell scripts (PC).
# Скопируй в scripts/project.conf и заполни. Файл project.conf в git не попадает.

# Читаемое имя проекта латиницей. Из него строится папка <LOCAL_BACKUP_ROOT>\<слаг>\
PROJECT_SLUG=my-project

# --- Сервер ---
SERVER_HOST=203.0.113.10
SERVER_USER=root
SERVER_APP_DIR=/opt/my-project
SERVER_ENV_FILE=/opt/my-project/.env
SERVER_BACKUP_DIR=/srv/my-project/backup
SERVER_STATE_DIR=/srv/my-project/state

# --- Бэкап базы (сервер) ---
# Схемы через запятую, если база общая. Пусто = вся база.
DB_SCHEMAS=
KEEP_DAILY=7
KEEP_WEEKLY=4
# Снимок старше стольких часов на сервере считается просроченным: забор на ПК вернёт код 2
STALE_HOURS=26
# Образ postgres должен быть не старше сервера БД
PG_IMAGE=postgres:16
PG_MAX_MAJOR=16

# --- Бэкап на ПК ---
LOCAL_BACKUP_ROOT=C:\project_backups
# Сколько дней держать снимки на ПК, но не меньше KEEP_AT_LEAST штук (пол сильнее срока)
KEEP_DAYS=30
KEEP_AT_LEAST=3
# Папки репозиториев через ;
LOCAL_REPOS=C:\work\my-project
KEEP_BUNDLES=14

# --- Деплой (подробно: docs/DEPLOY.md) ---
# Что выкатывается и в каком порядке. Порядок важен: схема базы раньше кода, бэкенд раньше фронта.
DEPLOY_ARTIFACTS=backend,frontend
# Python для scripts/checks.py и scripts/deployed.py (на Windows обычно python или py)
PYTHON_CMD=python
# Дополнительная проверка перед выкаткой (необязательно). Не прошла: выкатка не начинается.
#PRE_DEPLOY_CMD=npm run lint
# Полный набор тестов. Запускается только с ключом -WithTests, в обычную выкатку не входит.
TEST_CMD=pytest -q

# На каждый артефакт свой набор ключей <имя>.<ключ>.
# Пользователь ssh. Один артефакт, один пользователь: у каждого свои права на свой каталог.
backend.SSH_USER=deploy
# Каталог артефакта на сервере: внутри release.env, incoming/, releases/, current
backend.REMOTE_DIR=/srv/my-project/backend
# Серверный приёмник (server/release.sh, ставится на сервер один раз). Выкатка зовёт «<приёмник> --root <REMOTE_DIR> receive <архив>»
backend.RELEASE_SCRIPT=/usr/local/bin/release-backend.sh
# Адрес здоровья СНАРУЖИ (с ПК): по нему выкатка сверяет версию. Ответ: JSON с version.commit
backend.HEALTH_URL=https://example.com/health
# Сборка на ПК. Кладёт готовое в каталог $env:STAGE_DIR. Также доступны RELEASE_STAMP и DEPLOY_ARTIFACT
backend.BUILD_CMD=python scripts/build_backend.py
# Подкаталог внутри артефакта для version.json (если не корень)
#backend.VERSION_DIR=app

frontend.SSH_USER=deploy
frontend.REMOTE_DIR=/srv/my-project/frontend
frontend.RELEASE_SCRIPT=/usr/local/bin/release-frontend.sh
frontend.HEALTH_URL=https://example.com/healthz
frontend.BUILD_CMD=npm run build && Copy-Item -Recurse dist\* $env:STAGE_DIR
# Если приём не «<RELEASE_SCRIPT> --root <REMOTE_DIR>», задай свою команду целиком:
#frontend.RECEIVER=/usr/local/bin/release-frontend.sh --root /srv/my-project/frontend
